[Unit]
Description=Spotify <-> MQTT bridge (MPRIS)
After=network-online.target

[Service]
# Install: cp spotify-mqtt.py ~/.local/bin/spotify-mqtt && chmod +x ~/.local/bin/spotify-mqtt
#          echo SPOTIFY_MQTT_HOST=192.168.1.10 > ~/.config/spotify-mqtt.env
EnvironmentFile=%h/.config/spotify-mqtt.env
ExecStart=%h/.local/bin/spotify-mqtt
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
